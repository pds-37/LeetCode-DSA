#include <bits/stdc++.h>
using namespace std;

/* ---------------------- LC 198 (House Robber) ---------------------- */
class Solution198 {
public:
    int rob(vector<int>& nums) {
        int n = nums.size();
        if (n == 0) return 0;
        if (n == 1) return nums[0];

        vector<int> dp(n);
        dp[0] = nums[0];
        dp[1] = max(nums[0], nums[1]);

        for (int i = 2; i < n; i++)
            dp[i] = max(dp[i - 1], nums[i] + dp[i - 2]);

        return dp[n - 1];
    }
};

/* ---------------------- LC 213 (House Robber II) ---------------------- */
class Solution213 {
public:
    int helper(int start, int end, vector<int>& nums) {
        int len = end - start + 1;
        vector<int> dp(len);

        dp[0] = nums[start];
        if (len > 1)
            dp[1] = max(nums[start], nums[start + 1]);

        for (int i = 2; i < len; i++)
            dp[i] = max(dp[i - 1], nums[start + i] + dp[i - 2]);

        return dp[len - 1];
    }

    int rob(vector<int>& nums) {
        int n = nums.size();
        if (n == 0) return 0;
        if (n == 1) return nums[0];
        if (n == 2) return max(nums[0], nums[1]);

        return max(helper(0, n - 2, nums), helper(1, n - 1, nums));
    }
};

/* ---------------------- LC 62 (Unique Paths) ---------------------- */
class Solution62 {
public:
    int helper(int m, int n, vector<vector<int>>& dp) {
        if (m == 1 || n == 1) return 1;
        if (dp[m][n] != -1) return dp[m][n];

        dp[m][n] = helper(m - 1, n, dp) + helper(m, n - 1, dp);
        return dp[m][n];
    }

    int uniquePaths(int m, int n) {
        vector<vector<int>> dp(m + 1, vector<int>(n + 1, -1));
        return helper(m, n, dp);
    }
};

/* ---------------------- LC 63 (Unique Paths II) ---------------------- */
class Solution63 {
public:
    int helper(int n, int m, vector<vector<int>>& dp) {
        if (n < 0 || m < 0) return 0;
        if (dp[n][m] == INT_MIN) return 0;  // obstacle
        if (n == 0 && m == 0) return 1;
        if (dp[n][m] != -1) return dp[n][m];

        dp[n][m] = helper(n - 1, m, dp) + helper(n, m - 1, dp);
        return dp[n][m];
    }

    int uniquePathsWithObstacles(vector<vector<int>>& obstacleGrid) {
        int n = obstacleGrid.size();
        int m = obstacleGrid[0].size();

        vector<vector<int>> dp(n, vector<int>(m, -1));

        // mark obstacles
        for (int i = 0; i < n; i++)
            for (int j = 0; j < m; j++)
                if (obstacleGrid[i][j] == 1)
                    dp[i][j] = INT_MIN;

        return helper(n - 1, m - 1, dp);
    }
};

/* ---------------------- LC 64 (Minimum Path Sum) ---------------------- */
class Solution64 {
public:
    int minPathSum(vector<vector<int>>& grid) {
        int n = grid.size(), m = grid[0].size();
        vector<vector<int>> dp(n, vector<int>(m));

        for (int i = 0; i < n; i++) {
            for (int j = 0; j < m; j++) {
                if (i == 0 && j == 0)
                    dp[i][j] = grid[i][j];
                else if (i == 0)
                    dp[i][j] = grid[i][j] + dp[i][j - 1];
                else if (j == 0)
                    dp[i][j] = grid[i][j] + dp[i - 1][j];
                else
                    dp[i][j] = grid[i][j] + min(dp[i - 1][j], dp[i][j - 1]);
            }
        }
        return dp[n - 1][m - 1];
    }
};
